{
	"name": "@catalyst/mcp-server",
	"version": "1.88.9",
	"description": "MCP server for the Catalyst game-server panel. Exposes nodes, servers, users, roles, and more as MCP tools using a panel URL and API key.",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"bin": {
		"catalyst-mcp": "dist/index.js"
	},
	"scripts": {
		"build": "tsc",
		"build:bundle": "node scripts/build-bundle.mjs",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src",
		"test": "vitest run"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@eslint/js": "~10.0.1",
		"@types/node": "~26.6.6",
		"@typescript-eslint/eslint-plugin": "~8.72.1",
		"@typescript-eslint/parser": "~8.72.1",
		"@typescript/native": "npm:typescript@~7.0.2",
		"esbuild": "~0.28.2",
		"eslint": "~10.14.0",
		"globals": "~17.14.0",
		"tsx": "~4.23.15",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vitest": "~5.1.0"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
