{
	"name": "@catalyst/plugin-sdk-cli",
	"version": "1.64.1",
	"description": "CLI for scaffolding, building, and testing Catalyst plugins",
	"type": "module",
	"bin": {
		"catalyst-plugin": "./dist/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"dev": "tsc -p tsconfig.json --watch"
	},
	"dependencies": {
		"@catalyst/plugin-sdk": "workspace:*"
	},
	"devDependencies": {
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@types/node": "^26.6.2"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
