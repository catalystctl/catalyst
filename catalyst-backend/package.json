{
	"name": "catalyst-backend",
	"version": "1.64.0",
	"description": "Catalyst - Production-Grade Game Server Management System Backend",
	"main": "dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"overrides": {
		"@peculiar/asn1-schema": "2.6.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts -- --host",
		"build": "tsc && node scripts/fix-esm-extensions.mjs",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"start": "node dist/index.js --host",
		"db:push": "prisma db push --config prisma/prisma.config.ts",
		"db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
		"db:studio": "prisma studio --config prisma/prisma.config.ts",
		"db:generate": "prisma generate --config prisma/prisma.config.ts",
		"db:seed": "tsx prisma/seed.ts",
		"db:seed:admin": "tsx prisma/seed-admin.ts",
		"bulk-servers": "tsx scripts/bulk-servers.ts",
		"lint": "eslint src --ext .ts",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"openapi:export": "tsx scripts/export-openapi.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "~3.1139.0",
		"@better-auth/passkey": "~1.7.5",
		"@fastify/compress": "^9.2.0",
		"@fastify/cors": "~11.3.0",
		"@fastify/helmet": "~13.1.1",
		"@fastify/multipart": "~10.1.2",
		"@fastify/rate-limit": "~11.2.0",
		"@fastify/swagger": "~9.9.0",
		"@fastify/swagger-ui": "~6.1.1",
		"@fastify/websocket": "~11.3.1",
		"@prisma/adapter-pg": "~7.10.0",
		"@prisma/client": "~7.10.0",
		"@simplewebauthn/server": "~13.3.3",
		"@types/nodemailer": "~8.0.2",
		"better-auth": "~1.7.5",
		"chokidar": "~5.0.0",
		"cron-parser": "~5.10.1",
		"dotenv": "~18.0.3",
		"extract-zip": "^2.0.1",
		"fastify": "~5.12.5",
		"mysql2": "~3.24.4",
		"nanoid": "~6.0.1",
		"node-cron": "~4.6.0",
		"node-fetch": "~3.3.2",
		"nodemailer": "~10.0.10",
		"pg": "~8.23.0",
		"pino": "~10.3.1",
		"pino-pretty": "~13.1.3",
		"prisma": "~7.10.0",
		"ssh2": "~1.17.0",
		"uuid": "~14.0.2",
		"zod": "~4.6.5",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@eslint/js": "~10.0.1",
		"@types/archiver": "^8.0.0",
		"@types/node": "~26.6.2",
		"@typescript-eslint/eslint-plugin": "~8.70.1",
		"@typescript-eslint/parser": "~8.70.1",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitest/coverage-v8": "~5.0.1",
		"archiver": "^8.0.0",
		"eslint": "~10.11.0",
		"globals": "~17.12.0",
		"tsx": "~4.23.15",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vitest": "~5.0.1"
	}
}
