{
	"name": "catalyst-backend",
	"version": "1.89.0",
	"description": "Catalyst - Production-Grade Game Server Management System Backend",
	"main": "dist/start.js",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "node --import tsx --watch --watch-path=./src src/start.ts --host",
		"build": "tsc && node scripts/fix-esm-extensions.mjs",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"start": "node dist/start.js --host",
		"db:push": "prisma db push --config prisma/prisma.config.ts",
		"db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
		"db:studio": "prisma studio --config prisma/prisma.config.ts",
		"db:generate": "prisma generate --config prisma/prisma.config.ts",
		"db:seed": "tsx prisma/seed.ts",
		"db:seed:admin": "tsx prisma/seed-admin.ts",
		"db:migrate-permissions": "tsx prisma/migrate-permissions.ts",
		"bulk-servers": "tsx scripts/bulk-servers.ts",
		"lint": "eslint src --ext .ts",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"openapi:export": "tsx scripts/export-openapi.ts",
		"openapi:check": "tsx scripts/export-openapi.ts --check"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "~3.1167.0",
		"@better-auth/passkey": "~1.7.22",
		"@fastify/compress": "^9.3.0",
		"@fastify/cors": "~11.4.1",
		"@fastify/helmet": "~13.2.0",
		"@fastify/multipart": "~10.1.8",
		"@fastify/rate-limit": "~11.2.2",
		"@fastify/swagger": "~9.9.3",
		"@fastify/swagger-ui": "~6.1.3",
		"@fastify/websocket": "~11.3.7",
		"@prisma/adapter-pg": "~7.10.1",
		"@prisma/client": "~7.10.1",
		"@prometheus-io/client": "^0.16.1",
		"@simplewebauthn/server": "~14.1.0",
		"@types/nodemailer": "~8.0.2",
		"archiver": "^8.0.0",
		"better-auth": "~1.7.22",
		"chokidar": "~6.0.0",
		"cron-parser": "~5.10.5",
		"dotenv": "~18.0.10",
		"extract-zip": "^2.0.1",
		"fastify": "~5.12.8",
		"mysql2": "~3.24.6",
		"nanoid": "~6.0.2",
		"node-cron": "~4.6.0",
		"node-fetch": "~3.3.2",
		"nodemailer": "~10.5.0",
		"pg": "~8.23.1",
		"pino": "~10.4.0",
		"pino-pretty": "~13.2.0",
		"prisma": "~7.10.1",
		"ssh2": "~1.17.0",
		"uuid": "~14.0.3",
		"zod": "~4.6.7",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@eslint/js": "~10.0.1",
		"@types/archiver": "^8.0.0",
		"@types/node": "~26.6.6",
		"@typescript-eslint/eslint-plugin": "~8.72.2",
		"@typescript-eslint/parser": "~8.72.2",
		"@typescript/native": "npm:typescript@~7.0.2",
		"@vitest/coverage-v8": "~5.1.0",
		"eslint": "~10.14.0",
		"globals": "~17.14.0",
		"tsx": "~4.23.15",
		"typescript": "npm:@typescript/typescript6@~6.0.2",
		"vitest": "~5.1.0"
	}
}
