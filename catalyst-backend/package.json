{
	"name": "catalyst-backend",
	"version": "1.40.2",
	"description": "Catalyst - Production-Grade Game Server Management System Backend",
	"main": "dist/index.js",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"overrides": {
		"@peculiar/asn1-schema": "2.6.0"
	},
	"scripts": {
		"dev": "tsx watch src/index.ts -- --host",
		"build": "tsc && node scripts/fix-esm-extensions.mjs",
		"typecheck": "tsc -p tsconfig.typecheck.json",
		"start": "node dist/index.js --host",
		"db:push": "prisma db push --config prisma/prisma.config.ts",
		"db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
		"db:studio": "prisma studio --config prisma/prisma.config.ts",
		"db:generate": "prisma generate --config prisma/prisma.config.ts",
		"db:seed": "tsx prisma/seed.ts",
		"db:seed:admin": "tsx prisma/seed-admin.ts",
		"bulk-servers": "tsx scripts/bulk-servers.ts",
		"lint": "eslint src --ext .ts",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "~3.1107.0",
		"@better-auth/passkey": "~1.6.26",
		"@fastify/compress": "^9.2.0",
		"@fastify/cors": "~11.3.0",
		"@fastify/helmet": "~13.1.0",
		"@fastify/multipart": "~10.1.0",
		"@fastify/rate-limit": "~11.2.0",
		"@fastify/swagger": "~9.8.1",
		"@fastify/swagger-ui": "~6.1.1",
		"@fastify/websocket": "~11.3.0",
		"@prisma/adapter-pg": "~7.9.1",
		"@prisma/client": "~7.9.1",
		"@simplewebauthn/server": "~13.3.2",
		"@types/nodemailer": "~8.0.1",
		"better-auth": "~1.6.26",
		"chokidar": "~5.0.0",
		"cron-parser": "~5.8.1",
		"dotenv": "~17.4.2",
		"extract-zip": "^2.0.1",
		"fastify": "~5.11.3",
		"mysql2": "~3.23.3",
		"nanoid": "~6.0.1",
		"node-cron": "~4.6.0",
		"node-fetch": "~3.3.2",
		"nodemailer": "~9.0.5",
		"pg": "~8.23.0",
		"pino": "~10.3.0",
		"pino-pretty": "~13.1.3",
		"prisma": "~7.9.1",
		"ssh2": "~1.17.0",
		"uuid": "~14.0.1",
		"zod": "~4.4.1",
		"zod-to-json-schema": "^3.25.2"
	},
	"devDependencies": {
		"@eslint/js": "~10.0.1",
		"@types/archiver": "^6.0.4",
		"@types/extract-zip": "^2.0.3",
		"@types/node": "~26.2.0",
		"@typescript-eslint/eslint-plugin": "~8.67.0",
		"@typescript-eslint/parser": "~8.67.0",
		"@vitest/coverage-v8": "~4.1.10",
		"archiver": "^7.0.1",
		"eslint": "~10.8.1",
		"globals": "~17.9.0",
		"tsx": "~4.23.12",
		"typescript": "~6.0.3",
		"vitest": "~4.1.10"
	}
}
