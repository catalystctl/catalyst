{
	"name": "catalyst",
	"version": "1.87.3",
	"private": true,
	"type": "module",
	"workspaces": [
		"catalyst-backend",
		"catalyst-frontend",
		"catalyst-plugins/*",
		"packages/*"
	],
	"scripts": {
		"dev": "pnpm run dev:infra && pnpm -r --parallel --filter catalyst-backend --filter catalyst-frontend run dev --host",
		"dev:run": "./dev_run.sh",
		"dev:infra": "./scripts/dev-infra.sh",
		"dev:agent": "cd catalyst-agent && sudo cargo run -- ./config.toml",
		"dev:all": "pnpm run dev:infra && pnpm -r --parallel --filter catalyst-backend --filter catalyst-frontend run dev",
		"dev:stack": "./scripts/dev-stack.sh up",
		"dev:stack:build": "./scripts/dev-stack.sh build",
		"dev:stack:rebuild": "./scripts/dev-stack.sh rebuild",
		"dev:stack:down": "./scripts/dev-stack.sh down",
		"dev:stack:reset": "./scripts/dev-stack.sh reset",
		"dev:stack:logs": "./scripts/dev-stack.sh logs",
		"dev:stack:ps": "./scripts/dev-stack.sh ps",
		"dev:stack:shell": "./scripts/dev-stack.sh shell",
		"dev:stack:run": "./scripts/dev-stack.sh run",
		"dev:stack:test": "./scripts/dev-stack.sh test",
		"dev:stack:migrate": "./scripts/dev-stack.sh migrate",
		"dev:stack:seed": "./scripts/dev-stack.sh seed",
		"dev:stack:seed:admin": "./scripts/dev-stack.sh seed:admin",
		"dev:stack:help": "./scripts/dev-stack.sh help",
		"build": "pnpm run build:backend && pnpm run build:frontend",
		"build:backend": "pnpm --filter catalyst-backend run build",
		"build:frontend": "pnpm --filter catalyst-frontend run build",
		"build:agent": "cd catalyst-agent && cargo build --release",
		"start": "pnpm run build && pnpm -r --parallel --filter catalyst-backend --filter catalyst-frontend run start",
		"start:backend": "pnpm --filter catalyst-backend run start",
		"start:frontend": "pnpm --filter catalyst-frontend run start",
		"install:agent": "cd catalyst-agent && ./setup-dev.sh",
		"db:generate": "pnpm --filter catalyst-backend run db:generate",
		"db:push": "pnpm --filter catalyst-backend run db:push",
		"db:migrate": "pnpm --filter catalyst-backend run db:migrate",
		"db:seed": "pnpm --filter catalyst-backend run db:seed",
		"db:seed:admin": "pnpm --filter catalyst-backend run db:seed:admin",
		"db:studio": "pnpm --filter catalyst-backend run db:studio",
		"lint": "pnpm -r run lint",
		"test": "pnpm -r run test",
		"test:e2e": "pnpm --filter catalyst-frontend run test:e2e",
		"i18n:check": "node scripts/i18n-check.mjs",
		"i18n:hardcoded": "node scripts/i18n-hardcoded-check.mjs",
		"i18n:extract": "pnpm --filter catalyst-frontend run i18n:extract",
		"i18n:status": "pnpm --filter catalyst-frontend run i18n:status",
		"clean": "rm -rf catalyst-backend/dist catalyst-backend/node_modules catalyst-frontend/dist catalyst-frontend/node_modules node_modules",
		"prepare": "husky"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@typescript/native": "npm:typescript@~7.0.2",
		"autocannon": "^8.0.0",
		"husky": "^9.1.7",
		"typescript": "npm:@typescript/typescript6@~6.0.2"
	}
}
