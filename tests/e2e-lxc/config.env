# Catalyst LXC E2E — Minecraft pipeline defaults.
# Copy to a custom file and pass CONFIG=/path/to/file.env to e2e-minecraft.sh,
# or export any of these variables in the environment before running.

# --- LXC topology (single panel + single node, isolated from scripts/lxc-lab) ---
E2E_LXC_DISTRO="${E2E_LXC_DISTRO:-ubuntu}"
E2E_LXC_RELEASE="${E2E_LXC_RELEASE:-jammy}"
E2E_LXC_ARCH="${E2E_LXC_ARCH:-amd64}"

E2E_PANEL_LXC="${E2E_PANEL_LXC:-catalyst-e2e-panel}"
E2E_NODE_LXC="${E2E_NODE_LXC:-catalyst-e2e-node}"

# 10.0.3.0/24 is the default lxcbr0 network. .50/.51 avoid the
# scripts/lxc-lab defaults (.20/.21) so both labs can coexist.
E2E_PANEL_IP="${E2E_PANEL_IP:-10.0.3.50}"
E2E_NODE_IP="${E2E_NODE_IP:-10.0.3.51}"
E2E_GATEWAY="${E2E_GATEWAY:-10.0.3.1}"
E2E_NETMASK="${E2E_NETMASK:-24}"

E2E_PANEL_MEMORY="${E2E_PANEL_MEMORY:-6G}"
E2E_NODE_MEMORY="${E2E_NODE_MEMORY:-4G}"

# --- Panel under test ---
# E2E_USE_LOCAL=1 pushes the working tree's install.sh + catalyst-docker/
# into the panel LXC (tests uncommitted changes). =0 downloads install.sh
# from GitHub like a real user would (the default: exact user path).
E2E_USE_LOCAL="${E2E_USE_LOCAL:-0}"
E2E_REPO="${E2E_REPO:-catalystctl/catalyst}"
E2E_BRANCH="${E2E_BRANCH:-main}"
E2E_PANEL_PORT="${E2E_PANEL_PORT:-8080}"
E2E_PUBLIC_URL="${E2E_PUBLIC_URL:-http://${E2E_PANEL_IP}:${E2E_PANEL_PORT}}"
E2E_APP_NAME="${E2E_APP_NAME:-Catalyst E2E}"

# First-run admin created via /api/setup/complete.
E2E_ADMIN_EMAIL="${E2E_ADMIN_EMAIL:-e2e@catalyst.local}"
E2E_ADMIN_USERNAME="${E2E_ADMIN_USERNAME:-e2eadmin}"
E2E_ADMIN_PASSWORD="${E2E_ADMIN_PASSWORD:-CatalystE2E!2026}"

# --- Node / agent ---
# host: an isolated second agent runs on this host (own config, data dir,
# containerd namespace, CNI plugins, SFTP port) — the host's own agent is
# never touched. Game containers share the host kernel, so loop mounts work.
# lxc: the agent deploys into E2E_NODE_LXC. Needs a PRIVILEGED container:
# unprivileged LXCs cannot loop-mount the agent's ext4 disk images.
E2E_NODE_MODE="${E2E_NODE_MODE:-host}"
E2E_HOST_LXCBR_IP="${E2E_HOST_LXCBR_IP:-10.0.3.1}"
E2E_LOCATION_NAME="${E2E_LOCATION_NAME:-E2E Lab}"
E2E_NODE_NAME="${E2E_NODE_NAME:-e2e-node}"
E2E_NODE_MAX_MEMORY_MB="${E2E_NODE_MAX_MEMORY_MB:-8192}"
E2E_NODE_MAX_CPU="${E2E_NODE_MAX_CPU:-4}"

# Isolated host-agent paths (E2E_NODE_MODE=host only). The bridge name/subnet
# must not clash with the host's own agent (catalyst0/10.42.0.0/16).
E2E_HOST_AGENT_BIN="${E2E_HOST_AGENT_BIN:-/tmp/catalyst-e2e-agent}"
E2E_HOST_AGENT_CONFIG="${E2E_HOST_AGENT_CONFIG:-/tmp/catalyst-e2e-agent.toml}"
E2E_HOST_AGENT_PIDFILE="${E2E_HOST_AGENT_PIDFILE:-/tmp/catalyst-e2e-agent.pid}"
E2E_HOST_AGENT_LOG="${E2E_HOST_AGENT_LOG:-/tmp/catalyst-e2e-agent.log}"
E2E_HOST_AGENT_DATADIR="${E2E_HOST_AGENT_DATADIR:-/var/lib/catalyst-e2e}"
E2E_HOST_AGENT_NAMESPACE="${E2E_HOST_AGENT_NAMESPACE:-catalyst-e2e}"
E2E_HOST_AGENT_SFTP_PORT="${E2E_HOST_AGENT_SFTP_PORT:-2222}"
E2E_HOST_CNI_DIR="${E2E_HOST_CNI_DIR:-/tmp/catalyst-e2e-cni}"
E2E_HOST_BRIDGE="${E2E_HOST_BRIDGE:-catalyst-e2e0}"
E2E_HOST_SUBNET="${E2E_HOST_SUBNET:-10.44.0.0/16}"

# --- Minecraft Paper server ---
# E2E_TEMPLATES=paper imports just Paper (fast). =all imports every egg
# under eggs/ as well (nest per top-level game dir).
E2E_TEMPLATES="${E2E_TEMPLATES:-paper}"
E2E_MC_NAME="${E2E_MC_NAME:-E2E Minecraft Paper}"
E2E_MC_PORT="${E2E_MC_PORT:-25565}"
E2E_MC_MEMORY_MB="${E2E_MC_MEMORY_MB:-2048}"
E2E_MC_CPU="${E2E_MC_CPU:-2}"
E2E_MC_DISK_MB="${E2E_MC_DISK_MB:-8192}"
# PaperMC Fill API selectors. Pinned to a known-good version+build instead
# of "latest": latest tracks bleeding edge (26.x, Java 25+ only) and its
# metadata shape drifts, which breaks the egg's URL construction with
# cryptic "Could not resolve host: null" curl errors.
E2E_MC_VERSION="${E2E_MC_VERSION:-1.21.11}"
E2E_MC_BUILD="${E2E_MC_BUILD:-132}"
# Must match a key in eggs/minecraft/java/paper/egg-paper.json docker_images.
# "latest" Paper (26.x) requires Java 25+; Java 21 images crash at boot with
# "Minecraft 26.1 and newer requires running the server with Java 25 or above".
E2E_MC_IMAGE_VARIANT="${E2E_MC_IMAGE_VARIANT:-Java 25}"

# --- Run behaviour ---
# Where stage state, logs and the JUnit report land.
E2E_STATE_DIR="${E2E_STATE_DIR:-${HOME}/.local/share/catalyst-e2e-lxc}"
# Set to 1 to keep LXCs after a successful run for debugging.
E2E_KEEP_ON_SUCCESS="${E2E_KEEP_ON_SUCCESS:-0}"
# Seconds to wait for install/start phases before failing.
E2E_INSTALL_TIMEOUT_S="${E2E_INSTALL_TIMEOUT_S:-900}"
E2E_START_TIMEOUT_S="${E2E_START_TIMEOUT_S:-600}"
