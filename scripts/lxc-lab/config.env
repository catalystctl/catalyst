# Catalyst split LXC lab defaults. Override in the environment or by
# copying this file and passing CONFIG=/path/to/file.env to lab.sh.

LAB_NAME="${LAB_NAME:-catalyst-lxc-lab}"

# Unprivileged Ubuntu 22.04 LXCs (cached locally on this host).
LXC_DISTRO="${LXC_DISTRO:-ubuntu}"
LXC_RELEASE="${LXC_RELEASE:-jammy}"
LXC_ARCH="${LXC_ARCH:-amd64}"

BACKEND_LXC="${BACKEND_LXC:-catalyst-backend}"
PANEL_LXC="${PANEL_LXC:-catalyst-panel}"

BACKEND_IP="${BACKEND_IP:-10.0.3.20}"
PANEL_IP="${PANEL_IP:-10.0.3.21}"
LXC_GATEWAY="${LXC_GATEWAY:-10.0.3.1}"
LXC_NETMASK="${LXC_NETMASK:-24}"

BACKEND_MEMORY="${BACKEND_MEMORY:-6G}"
PANEL_MEMORY="${PANEL_MEMORY:-2G}"
BACKEND_CPU_QUOTA="${BACKEND_CPU_QUOTA:-400000 100000}"
PANEL_CPU_QUOTA="${PANEL_CPU_QUOTA:-200000 100000}"

# Host-facing panel URL (no TLS). socat publishes this on the LAN NIC.
HOST_LAN_IP="${HOST_LAN_IP:-192.168.1.78}"
PANEL_HOST_PORT="${PANEL_HOST_PORT:-8080}"
BACKEND_HOST_PORT="${BACKEND_HOST_PORT:-3000}"

# Isolated Pterodactyl + Wings fixture (migration e2e). Host ports avoid
# the Catalyst panel 8080, backend 3000, and agent SFTP 2022.
PTERO_PANEL_LXC="${PTERO_PANEL_LXC:-ptero-panel}"
PTERO_WINGS_LXC="${PTERO_WINGS_LXC:-ptero-wings}"
PTERO_PANEL_IP="${PTERO_PANEL_IP:-10.0.3.30}"
PTERO_WINGS_IP="${PTERO_WINGS_IP:-10.0.3.31}"
# Extra Wings guests for the 50-server fixture. Defaults skip 10.0.3.32,
# which is already occupied on this host.
PTERO_BULK_WINGS_LXCS="${PTERO_BULK_WINGS_LXCS:-ptero-wings-02,ptero-wings-03}"
PTERO_BULK_WINGS_IPS="${PTERO_BULK_WINGS_IPS:-10.0.3.34,10.0.3.35}"
PTERO_PANEL_HOST_PORT="${PTERO_PANEL_HOST_PORT:-8090}"
PTERO_WINGS_HOST_PORT="${PTERO_WINGS_HOST_PORT:-8081}"
PTERO_SFTP_HOST_PORT="${PTERO_SFTP_HOST_PORT:-2023}"
PTERO_PANEL_MEMORY="${PTERO_PANEL_MEMORY:-2G}"
PTERO_WINGS_MEMORY="${PTERO_WINGS_MEMORY:-3G}"
PTERO_PANEL_CPU_QUOTA="${PTERO_PANEL_CPU_QUOTA:-200000 100000}"
PTERO_WINGS_CPU_QUOTA="${PTERO_WINGS_CPU_QUOTA:-200000 100000}"
PTERO_PANEL_IMAGE="${PTERO_PANEL_IMAGE:-ghcr.io/pterodactyl/panel:v1.11.11}"
PTERO_WINGS_IMAGE="${PTERO_WINGS_IMAGE:-ghcr.io/pterodactyl/wings:v1.11.13}"
PTERO_ADMIN_EMAIL="${PTERO_ADMIN_EMAIL:-admin@ptero.local}"
PTERO_ADMIN_USERNAME="${PTERO_ADMIN_USERNAME:-pteroadmin}"
PTERO_ADMIN_PASSWORD="${PTERO_ADMIN_PASSWORD:-PteroLab!2026}"
PTERO_SERVER_NAME="${PTERO_SERVER_NAME:-Ptero Paper}"
PTERO_BULK_SERVER_COUNT="${PTERO_BULK_SERVER_COUNT:-50}"
PTERO_BULK_NODE_COUNT="${PTERO_BULK_NODE_COUNT:-3}"
PTERO_BULK_PORT_START="${PTERO_BULK_PORT_START:-25565}"
# Legacy override only. Extra-node IPs now come from PTERO_BULK_WINGS_IPS.
PTERO_BULK_ALLOC_IPS="${PTERO_BULK_ALLOC_IPS:-10.0.3.31,10.0.3.34,10.0.3.35}"

# Extra browser origins for the lab panel (comma-separated, no spaces).
LAB_CORS_ORIGINS="${LAB_CORS_ORIGINS:-http://${HOST_LAN_IP}:${PANEL_HOST_PORT},http://${PANEL_IP:-10.0.3.21}:8080,http://test.catalystctl.com,http://test.catalystctl.com:8080,https://test.catalystctl.com,https://test.catalystctl.com:8080}"

# Compose images
BACKEND_IMAGE="${BACKEND_IMAGE:-ghcr.io/catalystctl/catalyst-backend:latest}"
FRONTEND_IMAGE="${FRONTEND_IMAGE:-ghcr.io/catalystctl/catalyst-frontend:latest}"

# First-run admin. Stored in STATE_DIR after bootstrap.
ADMIN_EMAIL="${ADMIN_EMAIL:-admin@catalyst.local}"
ADMIN_USERNAME="${ADMIN_USERNAME:-admin}"
ADMIN_PASSWORD="${ADMIN_PASSWORD:-CatalystLab!2026}"
PANEL_NAME="${PANEL_NAME:-Catalyst Lab}"

# Node / agent
LOCATION_NAME="${LOCATION_NAME:-Lab}"
NODE_NAME="${NODE_NAME:-lab-host}"
NODE_HOSTNAME="${NODE_HOSTNAME:-$(hostname -f 2>/dev/null || hostname)}"
NODE_PUBLIC_ADDRESS="${NODE_PUBLIC_ADDRESS:-${HOST_LAN_IP}}"
NODE_MAX_MEMORY_MB="${NODE_MAX_MEMORY_MB:-16384}"
NODE_MAX_CPU="${NODE_MAX_CPU:-8}"

# Game servers
MC_NAME="${MC_NAME:-Minecraft Paper}"
MC_PORT="${MC_PORT:-25565}"
MC_MEMORY_MB="${MC_MEMORY_MB:-2048}"
MC_CPU="${MC_CPU:-2}"
MC_DISK_MB="${MC_DISK_MB:-8192}"

SOTF_NAME="${SOTF_NAME:-Sons of the Forest}"
SOTF_PORT="${SOTF_PORT:-8766}"
SOTF_QUERY_PORT="${SOTF_QUERY_PORT:-27016}"
SOTF_BLOB_PORT="${SOTF_BLOB_PORT:-9700}"
SOTF_MEMORY_MB="${SOTF_MEMORY_MB:-4096}"
SOTF_CPU="${SOTF_CPU:-4}"
SOTF_DISK_MB="${SOTF_DISK_MB:-20480}"
SOTF_PASSWORD="${SOTF_PASSWORD:-changeme}"

STATE_DIR="${STATE_DIR:-${HOME}/.local/share/catalyst-lxc-lab}"
REPO_ROOT="${REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
