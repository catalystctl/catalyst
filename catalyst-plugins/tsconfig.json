{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "paths": {
      "react": ["../catalyst-frontend/node_modules/@types/react"],
      "react-dom": ["../catalyst-frontend/node_modules/@types/react-dom"],
      "framer-motion": ["../catalyst-frontend/node_modules/framer-motion"],
      "lucide-react": ["../catalyst-frontend/node_modules/lucide-react"]
    }
  },
  "include": ["egg-explorer/frontend", "example-plugin/frontend", "ticketing-plugin/frontend"]
}
