# =============================================================================
# Catalyst — Docker Compose Configuration
# Copy this file to .env and fill in the required values.
# =============================================================================

# --- General -------------------------------------------------------------------
# Set to "development" for plain HTTP (disables HSTS/upgrade-insecure-requests).
# Set to "production" when behind a TLS-terminating reverse proxy.
NODE_ENV=development

# Public URL users will access the panel from (no trailing slash).
# This is the SINGLE SOURCE OF TRUTH for CORS, Better Auth trusted origins,
# deploy scripts, agent config, and email links.  It automatically drives:
#   BETTER_AUTH_URL, CORS_ORIGIN, FRONTEND_URL, BACKEND_EXTERNAL_ADDRESS, BACKEND_URL
# You only need to override those individually if you have a split internal/external
# setup (e.g. BACKEND_URL points to an internal Docker network address).
#
# IMPORTANT: Set this to the exact URL you type into your browser.
PUBLIC_URL=http://localhost:8080

# Optional extra CORS origins (comma-separated, no spaces). Defaults to PUBLIC_URL.
# CORS_ORIGIN=http://192.168.1.78:8080,http://test.catalystctl.com,https://test.catalystctl.com
# BACKEND_URL=http://10.0.3.20:3000
# BACKEND_EXTERNAL_ADDRESS=http://10.0.3.20:3000

# Panel name shown in emails and UI (default: Catalyst)
APP_NAME=Catalyst

# Enable HTTP response compression (gzip/br/deflate) in the Fastify backend.
# MUST be disabled when running behind nginx (Docker) — otherwise the
# @fastify/compress stream gets cut off before flushing its final bytes,
# causing "premature close" errors and truncated compressed responses.
# nginx handles compression itself in the Docker setup.
# ENABLE_COMPRESSION=false

# Timezone for log timestamps and scheduled tasks
TZ=UTC

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=catalyst
# Applied ONLY on first start of an empty data volume. Changing this later without
# wiping the catalyst-postgres-data volume does NOT update the DB user password and
# will cause Prisma P1000 auth failures. Prefer install.sh-generated URL-safe values
# (alphanumeric); special characters need URL-encoding in the connection string.
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
POSTGRES_DB=catalyst_db
# Optional: expose postgres port on the host (for external tools / pgAdmin)
POSTGRES_PORT=127.0.0.1:5432

# --- Redis --------------------------------------------------------------------
# Leave empty for no password (acceptable when redis is not exposed)
REDIS_PASSWORD=
# Optional: expose redis port on the host
# REDIS_PORT=127.0.0.1:6379

# --- Auth ----------------------------------------------------------------------
# REQUIRED — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# HMAC secret for hashing panel/agent API keys.
# Optional: if unset, docker-compose defaults API_KEY_SECRET to BETTER_AUTH_SECRET.
# Generate a separate value for key-rotation isolation: openssl rand -base64 32
# API_KEY_SECRET=

# Hostname or IP for passkey authentication — must match PUBLIC_URL host
PASSKEY_RP_ID=localhost

# --- Ports --------------------------------------------------------------------
# Bind addresses are 0.0.0.0 by default. Set to 127.0.0.1 to restrict to localhost.
# Note: rootless podman cannot bind ports below 1024. Use 8080 instead of 80.
FRONTEND_PORT=0.0.0.0:8080
BACKEND_PORT=127.0.0.1:3000
SFTP_PORT=0.0.0.0:2022

# --- SFTP ---------------------------------------------------------------------
SFTP_ENABLED=true
# Set to empty string to let the backend auto-generate a host key.
# Must be explicitly set when using podman-compose (variable interpolation quirk).
SFTP_HOST_KEY=
SFTP_HOST_KEY_BASE64=
# File size limit is the panel Admin → Security "Max upload size".


# --- Backups ------------------------------------------------------------------
# Storage mode: local (files on disk), s3 (S3-compatible), or stream
BACKUP_STORAGE_MODE=local
# Required to store per-server S3/SFTP backup credentials. openssl rand -base64 32
# BACKUP_CREDENTIALS_ENCRYPTION_KEY=
# Agent backup frames are 256 KiB; keep this >= 1048576.
# WS_MAX_PAYLOAD_BYTES=8388608

# --- S3 Backups (only if BACKUP_STORAGE_MODE=s3) ------------------------------
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_PATH_STYLE=true

# --- Performance tuning (optional) ------------------------------------------
# CONSOLE_OUTPUT_BYTE_LIMIT_BYTES=524288
# MAX_DISK_MB=1048576

# --- Webhooks (optional) -----------------------------------------------------
# WEBHOOK_URLS=https://your-webhook.example.com/notify
# WEBHOOK_SECRET=your-webhook-signing-secret

# --- Suspension (optional) ----------------------------------------------------
# SUSPENSION_ENFORCED=true
# SUSPENSION_DELETE_BLOCKED=false
# SUSPENSION_DELETE_POLICY=keep

# --- Optional: OAuth providers ------------------------------------------------
# WHMCS_OIDC_CLIENT_ID=
# WHMCS_OIDC_CLIENT_SECRET=
# WHMCS_OIDC_DISCOVERY_URL=
# PAYMENTER_OIDC_CLIENT_ID=
# PAYMENTER_OIDC_CLIENT_SECRET=
# PAYMENTER_OIDC_DISCOVERY_URL=

# --- SSL / TLS (Caddy or Traefik overlay) -----------------------------------
# Set these when using docker-compose.caddy.yml or docker-compose.traefik.yml.
# Requires a DNS A record pointing to your server and ports 80/443 accessible.

# Domain name for automatic HTTPS (e.g., panel.example.com)
# DOMAIN=

# Email for Let's Encrypt certificate notifications (optional but recommended)
# ACME_EMAIL=admin@example.com

# Reverse proxy bind addresses (defaults: 0.0.0.0:80 and 0.0.0.0:443)
# HTTP_PORT=0.0.0.0:80
# HTTPS_PORT=0.0.0.0:443

# Traefik dashboard (default: 127.0.0.1:8080 — localhost only)
# Set to empty to disable. WARNING: Never expose on 0.0.0.0 without auth.
# TRAEFIK_DASHBOARD_PORT=127.0.0.1:8080

# --- Auto Updater (optional) ------------------------------------------------
# Set to true to enable automatic update checking
AUTO_UPDATE_ENABLED=false
# Check interval in milliseconds (default: 1 hour)
AUTO_UPDATE_INTERVAL_MS=3600000
# Auto-trigger update when available (default: false - only notifies)
AUTO_UPDATE_AUTO_TRIGGER=false
# Absolute host path of this compose project. Must be bind-mounted at the same
# path in the backend container so the panel Update button can run docker compose.
# install.sh sets both automatically.
# CATALYST_COMPOSE_DIR=/opt/catalyst-docker
# AUTO_UPDATE_DOCKER_COMPOSE_PATH=/opt/catalyst-docker/docker-compose.yml
