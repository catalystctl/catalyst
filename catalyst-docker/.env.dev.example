# =============================================================================
# Catalyst - development stack settings (catalyst-docker/.env.dev)
#
# Created from .env.dev.example by `pnpm run dev:stack`, which also fills in the
# secrets. Only docker-compose.dev.yml reads this file; the standalone stack
# uses catalyst-docker/.env, and the host-based dev flow uses the workspace .env
# files.
#
# Every key must stay present: docker-compose.dev.yml substitutes them without
# defaults (podman-compose passes an unset ${VAR} through to the container
# literally). Keys added to .env.dev.example are merged into this file on the
# next `pnpm run dev:stack`.
#
# Host ports are resolved automatically: when a default port is already taken
# the wrapper picks the next free one, rewrites it here and keeps the URLs below
# in step (both printed when it happens). A port you set yourself is never
# changed - the stack refuses to start and says so instead, so the panel URL
# never moves behind your back.
#
# This file is gitignored. No shell syntax: values are read as plain strings.
# =============================================================================

# --- Host ports ---------------------------------------------------------------
# Left-hand side of each publish. Postgres and Redis are loopback-only.
DEV_FRONTEND_PORT=9173
DEV_BACKEND_PORT=9300
DEV_POSTGRES_PORT=5433
DEV_REDIS_PORT=6380

# --- Database -----------------------------------------------------------------
POSTGRES_USER=catalyst
POSTGRES_PASSWORD=catalyst_dev
POSTGRES_DB=catalyst_db

# --- Secrets ------------------------------------------------------------------
# BETTER_AUTH_SECRET is generated when empty. It signs session tokens, so
# changing it signs every dev session out. API_KEY_SECRET falls back to it.
BETTER_AUTH_SECRET=
API_KEY_SECRET=

# --- Panel URLs ---------------------------------------------------------------
# Derived from the ports above and rewritten when a port moves. Edit them only
# when you reach the panel through something other than localhost (for example
# a LAN IP or a tunnel hostname): a value that is not the derived one is kept.
PUBLIC_URL=http://localhost:9173
BETTER_AUTH_URL=http://localhost:9173
CORS_ORIGIN=http://localhost:9173
FRONTEND_URL=http://localhost:9173
# How agents reach the panel. They run on the host in dev, so localhost.
BACKEND_URL=http://localhost:9300
BACKEND_EXTERNAL_ADDRESS=http://localhost:9300

# --- Misc ---------------------------------------------------------------------
PASSKEY_RP_ID=localhost
TZ=UTC
# Backend log level: trace | debug | info | warn | error
LOG_LEVEL=info
APP_NAME=Catalyst
