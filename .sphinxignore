# mythos-agent / sphinx ignore rules
# This file is read by the scanner in addition to .mythos.yml `scan.exclude`.
# Keep in sync with .mythos.yml - scanner merges both.
# Last updated: 2026-08-19 - suppressed 96% FP vendor/test noise

# --- dependencies / build artifacts ---
**/node_modules/**
node_modules/**
**/dist/**
dist/**
**/build/**
build/**
**/target/**
target/**
**/vendor/**
vendor/**
**/__pycache__/**
**/.next/**
**/.vite/**
**/coverage/**
**/test-results/**
**/playwright-report/**
catalyst-frontend/dist/**
catalyst-backend/dist/**
catalyst-agent/target/**
packages/**/dist/**
packages/**/node_modules/**
tests/e2e/node_modules/**
tests/lib/node_modules/**
**/*.rmeta
**/*.html
**/target/doc/**

# --- tests / fixtures / benchmarks ---
**/__tests__/**
**/*.test.*
**/*.spec.*
**/*.min.js
**/*.stories.*
**/__mocks__/**
**/fixtures/**
tests/**
test/**
e2e/**
benchmarks/**
test-results/**
test-install-sh/**
eggs/**
catalyst-frontend/e2e/**
**/benchmarks/**

# --- generated / secrets (gitignored) ---
catalyst-agent/config.toml
catalyst-agent/config-e2e.toml
catalyst-backend/sftp_host_key
**/.env
**/.env.*
**/config.toml

# --- dev scripts / docs ---
**/vitest.config.*
**/prisma/seed*.ts
**/prisma/seed*.js
catalyst-backend/scripts/**
**/*.md

# --- known FP rules still noisy even in src (downgraded to warn in .sphinx/policy.yml) ---
# weak-crypto, timing-attack, unhandled-promise, insecure-cookie are 90-99% FP
# but we keep scanning them as warn; add per-file ignores only if needed:
# example: catalyst-backend/src/services/mysql.ts  # sql-injection is escaped via mysql.escape

# --- allowlist for gitleaks placeholders ---
# eggs/*.json contains example "Dedicated..." values not real keys
eggs/**
# .mythos.yml apiKey is ${ANTHROPIC_API_KEY} placeholder
.mythos.yml
